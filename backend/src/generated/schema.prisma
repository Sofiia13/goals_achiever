generator client {
  provider = "prisma-client-js"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  password     String
  refreshToken String? // для refresh токену
  createdAt    DateTime @default(now())
  goals        Goal[]
  photoUrl     String?
}

model Goal {
  id          Int       @id @default(autoincrement())
  title       String
  context     String?
  deadline    DateTime
  userId      Int
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id])
  tasks       Task[]
  completedAt DateTime?
}

model Task {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  status      String    @default("pending")
  dueDate     DateTime?
  generatedAt DateTime  @default(now())

  // AI / planning metadata
  type             String? // "learn" | "practice" | "review" | "reflect"
  estimatedMinutes Int?
  station          String? // для якої "станції" це завдання

  goalId Int
  goal   Goal @relation(fields: [goalId], references: [id])
}
